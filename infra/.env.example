# Local development environment for the dev backing services + the apps that
# connect to them. Copy to `.env` and adjust as needed:
#
#   cp infra/.env.example infra/.env
#
# The dev compose stack boots with the defaults below even if no .env exists;
# these values are for local development ONLY. Real secrets (production DB,
# OAuth client secrets, BETTER_AUTH_SECRET, real R2 keys) live in the host
# environment and are NEVER committed — see ARCHITECTURE.md §14.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=expense
POSTGRES_PASSWORD=expense
POSTGRES_DB=expense
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# --- MinIO (local stand-in for Cloudflare R2) -----------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RECEIPTS_BUCKET=receipts
BACKUPS_BUCKET=backups

# --- App service ports (dev) ----------------------------------------------
# api → 8000 (uvicorn), web → 3000 (next), auth → 4000 (bun/hono).
# PORT is read by the auth service's entrypoint; override here if needed.
PORT=4000

# --- Connection URLs the apps (FastAPI, Better Auth, worker) should use ----
# These point at the services above on localhost. In production these are
# replaced by the real Postgres/Redis URLs and real Cloudflare R2 endpoint.
DATABASE_URL=postgresql://expense:expense@localhost:5432/expense
REDIS_URL=redis://localhost:6379/0

# S3 / R2 access — boto3 talks to MinIO in dev via S3_ENDPOINT_URL.
# In production, drop S3_ENDPOINT_URL (use R2's endpoint) and swap the keys.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
