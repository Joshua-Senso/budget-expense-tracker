DATABASE_URL=postgresql://expense:expense@localhost:5432/expense
BETTER_AUTH_URL=http://localhost:4000
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
BETTER_AUTH_JWT_AUDIENCE=expense-api
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# OAuth providers — all optional; a provider is enabled only when both vars are set.
# Obtain credentials from each provider's developer console and set the callback URL to:
#   <BETTER_AUTH_URL>/api/auth/callback/<provider>  (e.g. http://localhost:4000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
