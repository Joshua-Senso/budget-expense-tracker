# Frontend public config. Copy to .env.local for dev; set the same keys as
# environment variables in Vercel for deploys. PUBLIC only — never put secrets
# here (anything NEXT_PUBLIC_* is shipped to the browser).
# Required by lib/api-client.ts and lib/auth-client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_URL=http://localhost:4000
# Public origin of the S3/R2/MinIO bucket the API mints presigned receipt
# upload/download URLs against (services/api S3_ENDPOINT_URL) -- the CSP in
# next.config.ts allows it so direct browser PUT/GET to storage isn't blocked.
NEXT_PUBLIC_STORAGE_ORIGIN=http://localhost:9000
